# Mirantes.Live — template de variáveis de ambiente (VERSIONADO, sem segredos)
# Copie para `.env` e preencha. Nunca comite o `.env` real.

# --- Postgres (fonte de verdade) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Redis (Pub/Sub realtime + cache) — canal goals:updates ---
REDIS_URL=redis://host:6379

# --- Segredos do servidor ---
# SESSION_SECRET assina o cookie de sessão (SPEC §3/§11). Mínimo 32 caracteres.
#   Gere um: `openssl rand -hex 32`
SESSION_SECRET=
# --- GitHub OAuth App (spec 009): cada usuário conecta a própria conta ---
# Registre um OAuth App (Settings → Developer settings → OAuth Apps) com
# Authorization callback URL = <APP_BASE_URL>/api/github/oauth/callback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Cifra o token OAuth em repouso (AES-256-GCM). 32 bytes em base64: `openssl rand -base64 32`
GITHUB_TOKEN_ENC_KEY=
# Base pública do app — monta o redirect_uri do OAuth. Ex.: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# --- Infra de TESTE (Vitest/Playwright) — banco/idx DEDICADOS, NUNCA os de dev (§5.3) ---
# Mesmo servidor da LAN, porém banco separado `mirantes_test` + índice Redis 1.
# Crie o banco uma vez: conecte no DB `postgres` e rode `CREATE DATABASE mirantes_test;`.
TEST_DATABASE_URL=postgresql://user:password@host:5432/mirantes_test
TEST_REDIS_URL=redis://host:6379/1

# --- Servidor MCP de Metas (spec 013 / 019) ---
# Token que o `bun run mcp` (stdio) usa no boot. OPCIONAL/LOCAL — só é exigido p/ subir o MCP via
# stdio (fail-closed). Dois usos:
#   • valor == este env → escopo ADMIN (operador/local);
#   • OU cole aqui o SEU token pessoal (gerado na tela de Integrações, spec 019) → escopo
#     `{ client, userId }` (opera só nos seus projetos).
# Gere um de serviço: `openssl rand -hex 32` (mín. 16 chars). NUNCA comitar o valor real (vai só no
# .env). O .mcp.json (versionado) NÃO leva o token — o Bun o carrega deste .env no startup.
MCP_SERVICE_TOKEN=
# MCP_TRANSPORT=stdio

# Atribuição commit→meta (spec 013): 100% determinística (keyword M-12 / branch / manual).
# O classificador LLM e suas envs LLM_CLASSIFIER_* foram removidos na spec 016.
